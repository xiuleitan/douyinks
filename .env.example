# Optional. Defaults to ~/Downloads/douyinks when omitted.
DOWNLOAD_ROOT=~/Downloads/douyinks
DOUYINKS_DAEMON_HOST=127.0.0.1
DOUYINKS_DAEMON_PORT=19826
DOWNLOAD_DELAY_SECONDS=3

# Enable phone file sync alongside the local browser bridge.
SYNC_SERVER_ENABLED=false
SYNC_SERVER_HOST=0.0.0.0
SYNC_SERVER_PORT=19827
# Use the same token as the phone app. Required when sync is enabled.
SYNC_TOKEN=
